{
  "name": "scp-entry-loom-of-fate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "dev:legacy": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:electron": "wait-on http://127.0.0.1:3000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .",
    "dev:desktop": "concurrently -k \"npm:dev:client\" \"npm:dev:electron\"",
    "build": "vite build",
    "build:desktop": "cross-env DESKTOP_BUILD=1 vite build",
    "pack:dir": "npm run build:desktop && electron-builder --dir",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.89.0",
    "@types/pako": "^2.0.4",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^6.14.0",
    "framer-motion": "^12.33.0",
    "hast-util-sanitize": "^5.0.2",
    "lucide-react": "^0.563.0",
    "nunjucks": "^3.2.4",
    "openai": "^6.15.0",
    "pako": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.14.0",
    "@types/nunjucks": "^3.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "39.6.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^25.0.1",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "scp.entry.loom.of.fate",
    "productName": "SCP Entry Loom of Fate",
    "directories": {
      "output": "dist-desktop"
    },
    "asar": true,
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "dir"
      ]
    },
    "linux": {
      "target": [
        "dir"
      ]
    }
  }
}
